# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional, local dev only — server.js defaults to 3000 if unset.
# On Render, PORT is set automatically; do not set it manually there.
# PORT=3000

# Phone + OTP login (Twilio Verify). Get these from the Twilio Console:
# https://console.twilio.com — Account SID/Auth Token are on the
# dashboard; the Verify Service SID comes from Verify > Services >
# Create new Service. Without all 3 set, /api/auth/* routes return a
# clear 503 but the rest of the app still works.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
